<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT1M2.5S">
  <BaseURL>../assets/</BaseURL>
  <Period id="p1">
    <BaseURL>first/</BaseURL>
    <AdaptationSet mimeType="video/mp4" codecs="avc1.4d401f" width="1280" height="720">
      <BaseURL>video/</BaseURL>
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc"/>
      <SegmentTemplate timescale="1000" initialization="init-$RepresentationID$.mp4" media="chunk-$Number$.m4s" duration="2000"/>
      <Representation id="v720" bandwidth="1500000"><BaseURL>720/</BaseURL></Representation>
      <Representation id="v1080" bandwidth="3000000" width="1920" height="1080"><BaseURL>1080.mp4?sig=x%2Fy&amp;k=2</BaseURL><SegmentBase indexRange="0-499"><Initialization sourceURL="start.mp4"/></SegmentBase></Representation>
    </AdaptationSet>
    <AdaptationSet contentType="audio" mimeType="audio/mp4" lang="en" codecs="mp4a.40.2">
      <Representation id="a1" bandwidth="128000"><BaseURL>audio.mp4</BaseURL><SegmentList><Initialization sourceURL="audio-init.mp4"/><SegmentURL media="audio-1.m4s"/></SegmentList></Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="text/vtt" lang="fr"><Representation id="s1"><BaseURL>fr.vtt</BaseURL></Representation></AdaptationSet>
  </Period>
  <Period id="p2"><BaseURL>second/</BaseURL><AdaptationSet mimeType="video/webm"><Representation id="v2"><BaseURL>last.webm</BaseURL></Representation></AdaptationSet></Period>
</MPD>
