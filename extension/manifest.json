{
  "manifest_version": 3,
  "name": "OmniGrab",
  "version": "0.1.0",
  "description": "Find videos on the current page and save supported HLS videos as MP4 with original video and audio.",
  "icons": { "16": "icons/omnigrab-16.png", "32": "icons/omnigrab-32.png", "48": "icons/omnigrab-48.png", "128": "icons/omnigrab-128.png" },
  "minimum_chrome_version": "120",
  "permissions": ["webRequest", "webNavigation", "storage", "downloads", "offscreen", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "OmniGrab", "default_popup": "popup/index.html", "default_icon": { "16": "icons/omnigrab-16.png", "32": "icons/omnigrab-32.png", "48": "icons/omnigrab-48.png" } },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_start",
    "world": "ISOLATED"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
