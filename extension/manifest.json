{
  "manifest_version": 3,
  "name": "Media Detection Lab",
  "version": "0.1.0",
  "description": "Local media detection diagnostics for direct sources, HLS and DASH.",
  "minimum_chrome_version": "120",
  "permissions": ["webRequest", "webNavigation", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Media Detection Lab", "default_popup": "popup/index.html" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_start",
    "world": "ISOLATED"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
